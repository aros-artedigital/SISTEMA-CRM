# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ir para o Git (ele guarda senhas).

# Endereço do banco PostgreSQL: postgresql://USUARIO:SENHA@SERVIDOR:PORTA/BANCO
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/crm?schema=public"

# Chave que assina o cookie de login (32 caracteres ou mais, aleatória).
# Para gerar uma:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Código pedido na tela "Primeiro acesso" (obrigatório em produção, opcional
# no seu computador). Sem ele, num site público, qualquer pessoa poderia criar
# o usuário administrador. Pode apagar depois de criar seu usuário.
CODIGO_PRIMEIRO_ACESSO=""
